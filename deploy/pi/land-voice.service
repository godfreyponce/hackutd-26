[Unit]
Description=LAND voice (speaks and listens through the I2S mics + MAX98357A)
After=land-hub.service pipewire.service wireplumber.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
EnvironmentFile=-%h/.config/land/env
ExecStart=%h/hackutd-26/.venv/bin/python -m software.voice
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
