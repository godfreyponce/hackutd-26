[Unit]
Description=LAND agent (Nemotron check-in, alarm rule in code)
After=land-hub.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
EnvironmentFile=-%h/.config/land/env
ExecStart=%h/hackutd-26/.venv/bin/python -m software.agent
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
