[Unit]
Description=LAND sensors (MPU-6050 quake, BMP280 indoor, PIR) -> hub
After=land-hub.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
Environment=HUB_URL=ws://localhost:8765
ExecStart=%h/hackutd-26/.venv-hw/bin/python hardware/sensors/sensors.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
