[Unit]
Description=LAND camera (Hailo pose -> camera events; boxes -> software.presence -> presence/fall_hint)
After=land-hub.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
Environment=HUB_URL=ws://localhost:8765
# posture.py sends help_gesture/people/camera_shake/lights itself; presence/fall_hint come only from software.presence
ExecStart=/bin/bash -o pipefail -c '%h/hackutd-26/.venv-hw/bin/python hardware/vision/posture.py --no-window --boxes --no-presence --hub ws://localhost:8765 | %h/hackutd-26/.venv/bin/python -m software.presence --stdin'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
