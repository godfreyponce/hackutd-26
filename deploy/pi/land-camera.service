[Unit]
Description=LAND camera (Hailo pose -> camera events; boxes -> software.presence -> presence/fall_hint)
After=land-hub.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
Environment=HUB_URL=ws://localhost:8765
# posture.py sends fall_hint (LYING + still only), help_gesture, people, camera_shake, lights.
# software.presence sends presence moving|still|none only (--no-fall-hint): just stopping never starts a check-in.
ExecStart=/bin/bash -o pipefail -c '%h/hackutd-26/.venv-hw/bin/python hardware/vision/posture.py --no-window --boxes --no-presence --stream-port 8090 --hub ws://localhost:8765 | %h/hackutd-26/.venv/bin/python -m software.presence --stdin --no-fall-hint'
StandardOutput=append:%h/land-logs/camera.log
StandardError=append:%h/land-logs/camera.log
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
