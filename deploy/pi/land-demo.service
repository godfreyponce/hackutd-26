[Unit]
Description=LAND demo runner (demo page buttons -> real pipelines, e.g. radio SAME decoder)
After=land-hub.service
Wants=land-hub.service

[Service]
WorkingDirectory=%h/hackutd-26
Environment=HUB_URL=ws://localhost:8765
EnvironmentFile=-%h/.config/land/env
ExecStart=%h/hackutd-26/.venv/bin/python hardware/demo/runner.py
StandardOutput=append:%h/land-logs/demo.log
StandardError=append:%h/land-logs/demo.log
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
